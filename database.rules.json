{
  "rules": {
    "roles": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).val() === '*'",
      "$uid": {
        ".validate": "newData.isString() && (newData.val() === 'event_organizer' || newData.val() === 'teacher' || newData.val() === 'admin')"
      }
    },
    "qrVersions": {
      ".read": false,
      ".write": false

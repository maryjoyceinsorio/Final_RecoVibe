        ".write": "auth != null && (root.child('roles').child(auth.uid).val() === 'event_organizer' || root.child('roles').child(auth.uid).val() === 'teacher') && ((newData.exists() && newData.child('organizerUid').val() === auth.uid && newData.child('status').val() === 'pending' && (!data.exists() || (data.child('organizerUid').val() === auth.uid && data.child('status').val() === 'pending' && !root.child('approvals').child($eventId).exists() && !root.child('organizerEvents').child(auth.uid).child($eventId).exists()))) || (!newData.exists() && data.child('organizerUid').val() === auth.uid && data.child('status').val() === 'pending' && !root.child('approvals').child($eventId).exists() && !root.child('organizerEvents').child(auth.uid).child($eventId).exists()))",
        ".validate": "newData.hasChildren(['id', 'eventId', 'name', 'date', 'dateEnd', 'venue', 'organizerUid', 'status', 'approvalStages', 'clientRequestId']) && newData.child('id').val() === $eventId && newData.child('eventId').val() === $eventId && newData.child('name').isString() && newData.child('name').val().length >= 3 && newData.child('date').isString() && newData.child('dateEnd').isString() && newData.child('venue').isString() && newData.child('organizerUid').isString() && newData.child('status').val() === 'pending' && newData.child('approvalStages').exists() && newData.child('clientRequestId').isString() && newData.child('clientRequestId').val().length <= 120"
      }
    },
    "registrations": {
      "$eventId": {
        ".read": "auth != null && ((root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).exists() && (root.child('approverOrganizations').child(auth.uid).val() === '*' || root.child('events').child($eventId).child('organizationCode').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organizerOrganization').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organization').val() === root.child('approverOrganizations').child(auth.uid).val())) || ((root.child('events').child($eventId).child('organizerUid').val() === auth.uid || root.child('events').child($eventId).child('organizerId').val() === auth.uid) && (root.child('roles').child(auth.uid).val() !== 'admin' || (root.child('approverOrganizations').child(auth.uid).exists() && (root.child('approverOrganizations').child(auth.uid).val() === '*' || root.child('events').child($eventId).child('organizationCode').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organizerOrganization').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organization').val() === root.child('approverOrganizations').child(auth.uid).val())))))",
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "userRegistrations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "attendance": {
      "$eventId": {
        ".read": "auth != null && ((root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).exists() && (root.child('approverOrganizations').child(auth.uid).val() === '*' || root.child('events').child($eventId).child('organizationCode').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organizerOrganization').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organization').val() === root.child('approverOrganizations').child(auth.uid).val())) || ((root.child('events').child($eventId).child('organizerUid').val() === auth.uid || root.child('events').child($eventId).child('organizerId').val() === auth.uid) && (root.child('roles').child(auth.uid).val() !== 'admin' || (root.child('approverOrganizations').child(auth.uid).exists() && (root.child('approverOrganizations').child(auth.uid).val() === '*' || root.child('events').child($eventId).child('organizationCode').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organizerOrganization').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organization').val() === root.child('approverOrganizations').child(auth.uid).val())))))",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || (root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).exists() && (root.child('approverOrganizations').child(auth.uid).val() === '*' || root.child('events').child($eventId).child('organizationCode').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organizerOrganization').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organization').val() === root.child('approverOrganizations').child(auth.uid).val())) || ((root.child('events').child($eventId).child('organizerUid').val() === auth.uid || root.child('events').child($eventId).child('organizerId').val() === auth.uid) && root.child('roles').child(auth.uid).val() !== 'admin'))",
          ".write": false
        }
      }
    },
    "approverDirectory": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).val() === '*'"
    },
    "approvals": {
      "$eventId": {
        ".read": "auth != null && ((root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).exists() && (root.child('approverOrganizations').child(auth.uid).val() === '*' || root.child('events').child($eventId).child('organizationCode').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organizerOrganization').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organization').val() === root.child('approverOrganizations').child(auth.uid).val())) || ((root.child('events').child($eventId).child('organizerUid').val() === auth.uid || root.child('events').child($eventId).child('organizerId').val() === auth.uid) && (root.child('roles').child(auth.uid).val() !== 'admin' || (root.child('approverOrganizations').child(auth.uid).exists() && (root.child('approverOrganizations').child(auth.uid).val() === '*' || root.child('events').child($eventId).child('organizationCode').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organizerOrganization').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organization').val() === root.child('approverOrganizations').child(auth.uid).val())))) || (root.child('approverQueue').child(auth.uid).child($eventId).exists() && root.child('approverOrganizations').child(auth.uid).exists() && (root.child('approverOrganizations').child(auth.uid).val() === '*' || root.child('events').child($eventId).child('organizationCode').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organizerOrganization').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organization').val() === root.child('approverOrganizations').child(auth.uid).val())))",
        ".write": false
      }
    },
    "organizerEvents": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).val() === '*'))",
        ".write": false
      }
    },
    "drafts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$draftId": {
          ".validate": "newData.hasChildren(['name', 'status', 'updatedAt']) && newData.child('name').isString() && newData.child('name').val().length <= 120 && newData.child('status').val() === 'draft' && newData.child('updatedAt').isNumber()"
        }
      }
    },
    "reuseLibrary": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$eventId": {
          "hidden": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean()"
          },
          "updatedAt": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber()"
          },
          "favorite": {
            ".write": false,
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".write": false
          }
        }
      }
    },
    "publicEvents": {
      ".read": true,
      ".write": "auth != null && (root.child('roles').child(auth.uid).val() === 'event_organizer' || root.child('roles').child(auth.uid).val() === 'teacher' || (root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).val() === '*'))",
      ".indexOn": ["startAt"]
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && (auth.uid === $uid || root.child('roles').child(auth.uid).val() === 'event_organizer' || root.child('roles').child(auth.uid).val() === 'teacher' || (root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).val() === '*'))"
      }
    },
    "absences": {
      "$eventId": {
        ".read": "auth != null && ((root.child('roles').child(auth.uid).val() === 'event_organizer' && (root.child('events').child($eventId).child('organizerUid').val() === auth.uid || root.child('events').child($eventId).child('organizerId').val() === auth.uid)) || root.child('roles').child(auth.uid).val() === 'teacher' || (root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).exists() && (root.child('approverOrganizations').child(auth.uid).val() === '*' || root.child('events').child($eventId).child('organizationCode').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organizerOrganization').val() === root.child('approverOrganizations').child(auth.uid).val() || root.child('events').child($eventId).child('organization').val() === root.child('approverOrganizations').child(auth.uid).val())))",
        ".write": false
      }
    },
    "approverQueue": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).val() === '*'))",
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).val() === '*'"
      }
    },
    "approverDecisions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('roles').child(auth.uid).val() === 'admin' && root.child('approverOrganizations').child(auth.uid).val() === '*'"
      }
    },
    "approverOrganizations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('roles').child(auth.uid).val() === 'admin')",
        "firstName": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "middleName": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "lastName": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 50"
        },
        "contactNumber": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().matches(/^09\\d{9}$/)"
        },
        "studentNo": {
          ".write": false
        },
        "yearSection": {
          ".write": false
        },
        "department": {
          ".write": false
        },
        "organization": {
          ".write": false
        },
        "email": {
          ".write": false
        },
        "preferences": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['categories', 'sources']) && newData.child('categories').hasChildren() && newData.child('sources').hasChildren()",
          "categories": {
            "$index": {
              ".validate": "newData.isString() && (newData.val() === 'Academic & Learning' || newData.val() === 'Tech & Innovation' || newData.val() === 'Seminars & Workshops' || newData.val() === 'Leadership & Career' || newData.val() === 'Orgs & Student Acts' || newData.val() === 'Social Events' || newData.val() === 'University & Campuses' || newData.val() === 'Community & Outreach' || newData.val() === 'Music & Entertainment' || newData.val() === 'Arts & Culture' || newData.val() === 'Sports & Fitness' || newData.val() === 'Competitions')"
            }
          },
          "sources": {
            "$index": {
              ".validate": "newData.isString() && (newData.val() === 'PUP Official' || newData.val() === 'CSC' || newData.val() === 'Teacher / Faculty' || newData.val() === 'Organizational' || newData.val() === 'Others / External')"
            }
          }
        },
        "$other": {
          ".write": false
        }
      }
    },
    "correctionRequests": {
      "$id": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || root.child('roles').child(auth.uid).val() === 'admin')",
        ".write": "auth != null && (!data.exists() ? (newData.child('uid').val() === auth.uid && newData.child('status').val() === 'open') : false)",
        ".validate": "newData.hasChildren(['uid', 'field', 'message', 'status', 'createdAt']) && newData.child('uid').val() === auth.uid && newData.child('status').val() === 'open' && newData.child('message').isString() && newData.child('message').val().length >= 10"
      }
    }
  }
}
